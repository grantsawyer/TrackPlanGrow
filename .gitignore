# Real data lives in ~/.fintrack (FINTRACK_HOME), never in this repo.
# These rules are a safety net in case something lands here by mistake.

# Secrets
.env
.env.*
!.env.example

# Databases and backups
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/

# TLS certificates and keys
*.pem
*.key
*.crt
certs/

# Bank downloads (fintrack import): real transactions
*.csv
*.tsv
*.xlsx
*.xls
*.ofx
*.qfx
*.qbo
*.qif

# Logs
*.log
logs/

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
