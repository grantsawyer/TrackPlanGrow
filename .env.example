# Copy to ~/.fintrack/.env (`fintrack init` does this for you) and fill in.
# Never put the real file inside the repo.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=

# "sandbox" (fake banks) or "production" (real accounts, uses Item budget)
PLAID_ENV=sandbox

# HTTPS port on localhost. The redirect URI registered in the Plaid
# dashboard must match: https://localhost:<port>/oauth-return
FINTRACK_PORT=8443

# Plaid Trial plan allows 10 Production Items, and removing one does NOT
# refund it. The app refuses to create Production Items beyond this number.
PLAID_PRODUCTION_ITEM_LIMIT=10

# Optional: stock prices from Alpaca (alpaca.markets, free "Paper Only" account; keys from
# the Paper dashboard). Live prices plus daily price history for your stocks, ETFs and the
# benchmark ETFs. Alpaca only sees the ticker symbols looked up. Leave empty to use Plaid's
# prices only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Production only: also fetch investment transactions (contributions, withdrawals, dividends) from your
# brokerage / retirement connections. Plaid bills this as its own subscription per connection and
# publishes no price, so it stays OFF in Production until you turn it on here after checking the price
# in the Plaid dashboard. The Sandbox always fetches them (free).
INVESTMENT_TRANSACTIONS=off

# Phone access away from home, no app on the phone (README "Phone access"). Set these with `fintrack remote setup`
# and `fintrack remote enable`, not by hand. REMOTE_HOST: your home's public IP (or a hostname for it), as phones
# dial it. REMOTE_PORT: the TCP port your router forwards to this Mac, where the sandboxed gate listens.
REMOTE_ACCESS=off
REMOTE_HOST=
REMOTE_PORT=48443
# Phones keep an encrypted read-only copy of the main pages, shown when the Mac doesn't answer (asleep, off). Off:
# phones are told to remove it at their next visit (docs/phone-offline.md).
PHONE_OFFLINE_COPY=off
